{
  "name": "treasurer-personal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "volta": {
    "node": "22.15.0",
    "pnpm": "9.15.4"
  },
  "devDependencies": {
    "eslint": "10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript-eslint": "8.59.3"
  },
  "scripts": {
    "dev:web": "pnpm --filter frontend dev",
    "dev:api": "pnpm --filter backend start:dev",
    "studio": "pnpm --filter backend prisma:studio",
    "build:web": "pnpm --filter frontend build",
    "build:api": "pnpm --filter backend build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json}\" --ignore-path .prettierignore"
  }
}
